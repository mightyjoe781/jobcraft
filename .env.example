# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=change-this-to-a-strong-password

# DATABASE_URL must use the same password as POSTGRES_PASSWORD above.
# Replace "change-this-to-a-strong-password" with the same value.
DATABASE_URL=postgresql+asyncpg://jobcraft:change-this-to-a-strong-password@postgres:5432/jobcraft

# ── LLM Provider ─────────────────────────────────────────────────────────────
# Set LLM_PROVIDER to "anthropic" (default) or "openai".
# Only the key for the active provider is required.
LLM_PROVIDER=anthropic

# Anthropic — named JOBCRAFT_ANTHROPIC_KEY (not ANTHROPIC_API_KEY) to avoid
# being intercepted by the Claude Code CLI, which uses the standard key name.
JOBCRAFT_ANTHROPIC_KEY=sk-ant-...your-key-here...

# OpenAI — only required when LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-...your-openai-key-here...

# ── LLM Result Cache ──────────────────────────────────────────────────────────
# How long to keep cached LLM responses in Redis (seconds). 0 = no expiry.
# Default: 604800 (7 days). Cache keys are content-hashed, so stale results
# are never served — expiry is just a cleanup mechanism.
# LLM_RESULT_CACHE_TTL_SECONDS=604800

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-this-to-a-long-random-string

# Registration gate — users must enter this token to create an account.
# Leave empty (or remove the line) to allow open registration.
# REGISTRATION_TOKEN=your-invite-token-here

# ── Storage ───────────────────────────────────────────────────────────────────
# "local" stores files in a Docker volume (default for self-hosted).
# "s3" requires the S3_* variables below.
STORAGE_BACKEND=local
STORAGE_LOCAL_ROOT=/storage

# S3 (only required when STORAGE_BACKEND=s3)
# S3_BUCKET=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1

# ── Internal service URLs ─────────────────────────────────────────────────────
# These point to Docker Compose service names — do not change unless you rename services.
LATEX_SERVICE_URL=http://latex:8001
REDIS_URL=redis://redis:6379/0

# Admin — the email of the designated admin user
ADMIN_EMAIL=admin@sudomoon.com
ADMIN_PASSWORD=change-this-strong-password
